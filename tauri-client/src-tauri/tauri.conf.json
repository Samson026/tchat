{
	"$schema": "https://schema.tauri.app/config/2",
	"productName": "tChat",
	"version": "0.1.0",
	"identifier": "com.samdietz.tauri-client",
	"build": {
		"beforeDevCommand": "bun run dev",
		"devUrl": "http://localhost:1420",
		"beforeBuildCommand": "bun run build",
		"frontendDist": "../dist"
	},
	"app": {
		"windows": [
			{
				"title": "tChat",
				"width": 800,
				"height": 600
			}
		],
		"security": {
			"csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": {
          "allow": ["$APPDATA/**/*"],
          "deny": ["$APPCACHE/**/secrets/**"]
        }
      }
    }
	},
	"bundle": {
		"active": true,
		"targets": "all",
		"icon": [
			"icons/32x32.png",
			"icons/128x128.png",
			"icons/128x128@2x.png",
			"icons/icon.icns",
			"icons/icon.ico"
		]
	}
}
